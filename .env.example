# Public browser configuration (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never expose this in browser code or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Invitation-only beta gate. Comma-separated, lowercase guardian email addresses.
RK_BETA_ALLOWED_EMAILS=

# Keep beta enabled until a separate, reviewed public-launch change is merged.
RK_BETA_MODE=true
